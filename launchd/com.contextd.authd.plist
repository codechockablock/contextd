<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The authority/storage daemon. NOT INSTALLED by this repository.

  This is a LaunchDaemon (system-wide, /Library/LaunchDaemons), not a
  LaunchAgent, because it must run as a dedicated service account rather than
  as the logged-in user. Installing it is an operator action requiring root:
  see docs/DEPLOYMENT.md §4.

  The security properties come from the ownership this file assumes, not from
  the file itself:
    * the program lives in root-owned, non-user-writable installed code
    * UserName/GroupName is a dedicated service account
    * the archive under /var/db/contextd is 0700 and owned by that account
    * the socket directory is 0750 group staff, so the desktop user may
      connect but may not read the archive behind it
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.contextd.authd</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/contextd/contextd-authd</string>
        <string>--socket</string>
        <string>/var/run/contextd/authd.sock</string>
    </array>

    <!-- the whole point: not the desktop user -->
    <key>UserName</key>
    <string>_contextd</string>
    <key>GroupName</key>
    <string>_contextd</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CONTEXTD_HOME</key>
        <string>/var/db/contextd</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 0007 => new files 0660 / dirs 0770 within the service account -->
    <key>Umask</key>
    <integer>7</integer>

    <key>StandardOutPath</key>
    <string>/var/log/contextd-authd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/contextd-authd.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
