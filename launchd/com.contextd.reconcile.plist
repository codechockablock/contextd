<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.contextd.reconcile</string>
    <key>ProgramArguments</key>
    <array>
        <string>__CONTEXTD_REPO__/.venv/bin/python</string>
        <string>__CONTEXTD_REPO__/hooks/reconcile.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>__CONTEXTD_ARCHIVE__/reconcile.log</string>
    <key>StandardErrorPath</key>
    <string>__CONTEXTD_ARCHIVE__/reconcile.log</string>
</dict>
</plist>
